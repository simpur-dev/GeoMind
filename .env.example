# GeoMind 环境变量样例（复制为 .env 并按需填写；.env 不入库）。
# 全部变量带 GEOMIND_ 前缀，未配置时默认值可直接跑通本机生产库 geomind。

# ---- L6 OceanBase SeekDB（默认即本机容器口径）----
#GEOMIND_OB_HOST=127.0.0.1
#GEOMIND_OB_PORT=2881
#GEOMIND_OB_USER=root
#GEOMIND_OB_PASSWORD=
#GEOMIND_OB_DATABASE=geomind

# ---- Embedding（synthetic = 阶段 0 合成向量；bge = 真实 BGE-m3 服务）----
#GEOMIND_EMBEDDING_PROVIDER=synthetic
#GEOMIND_EMBEDDING_DIM=1024

# ---- LLM 网关（决策综合节点；provider=fake 时用模板结论，不产生外部请求）----
#GEOMIND_LLM_PROVIDER=fake            # fake | deepseek | doubao
#GEOMIND_LLM_BASE_URL=                # deepseek 默认 https://api.deepseek.com
#GEOMIND_LLM_API_KEY=                 # sk- 开头；只放 .env，不入库
#GEOMIND_LLM_MODEL=                   # deepseek 默认 deepseek-chat；豆包填方舟接入点 id

# ---- 高德网关（服务端 key；与前端 web/.env 的 JS API key 是两种 key，不可混用）----
#GEOMIND_AMAP_KEY=                      # 控制台 Key 平台选「Web服务」
#GEOMIND_AMAP_SIGNATURE_SECRET=         # 数字签名私钥（该 key 配置了签名才填）
#GEOMIND_AMAP_QPS=3                     # 个人 key 限流口径

# ---- site_selection 打分权重（可解释可复现）----
#GEOMIND_SCORE_WEIGHT_SEMANTIC=0.35
#GEOMIND_SCORE_WEIGHT_TRAFFIC=0.30
#GEOMIND_SCORE_WEIGHT_RATING=0.25
#GEOMIND_SCORE_WEIGHT_COMPETITION=0.10
